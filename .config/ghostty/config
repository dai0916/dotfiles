# Ghostty configuration

# テーマ
theme = Catppuccin Mocha
#theme = dracula

# 見た目系
background-opacity = 0.5
window-padding-x = 10
window-padding-y = 10

# フォント
font-family = "JetBrainsMono Nerd Font"
font-family = "LINE Seed JP"
#font-family = "JetBrains Mono"
#font-family = "0xProto Nerd Font Mono"
#font-family = "BlexMono Nerd Font Mono"
#font-family = Menlo
# 日本語対応おすすめ
#font-family = "Cica"
#font-family = "PlemolJP Console NF"
#font-family = "UDEV Gothic NF"
#font-family = "Source Han Code JP"
#font-family = "MoralerspaceNeon"
#font-family = "PlemolJP Console NF"
#font-family = "FirgeNerd Console"
#font-family = "MoralerspaceKrypton"   # 他: Neon / Argon / Radon / Xenon

font-size = 21
font-thicken = false

font-feature = -calt,-dlig
adjust-cell-height = 1.5

# macOSっぽさ・使い勝手
macos-titlebar-style = hidden
macos-non-native-fullscreen = true
mouse-hide-while-typing = true
cursor-style = block
cursor-click-to-move = true
